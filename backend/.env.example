# ClearClause Backend — Environment Variables
# Copy this file to backend/.env and fill in your own values.
# Get a Hugging Face access token at https://huggingface.co/settings/tokens

HF_TOKEN=your_huggingface_token_here
HF_MODEL=Qwen/Qwen3-8B
HF_PROVIDER=auto

# ─── Fault-tolerance configuration (all optional, sensible defaults) ─────────
# Application-level request-size guard (unrelated to the NLI model's own
# token limit, which is checked separately at inference time).
MAX_INPUT_LENGTH_CHARS=20000

# NLI verifier model source. Accepts a Hugging Face hub id OR a local
# directory path to a fine-tuned checkpoint — swap this to point at your own
# checkpoint with no code change. Defaults to this project's fine-tuned
# checkpoint (fine-tuned from cross-encoder/nli-deberta-v3-small); set to
# cross-encoder/nli-deberta-v3-small directly to use the un-fine-tuned base
# model instead.
NLI_MODEL_PATH=jashokkkk/clearclause-nli-deberta

# Backoff (seconds) between a transient failure and its one retry.
SIMPLIFY_RETRY_BACKOFF_SECONDS=1.0
CLAIM_RETRY_BACKOFF_SECONDS=1.0
